# RevenueCat public SDK keys (Project settings → API keys). Without them the paywall shows "Purchases unavailable".
EXPO_PUBLIC_RC_IOS_KEY=appl_xxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxx
# Optional: shown on the paywall next to Terms of Use
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
# optional: email for the Business waitlist "Notify me" button
EXPO_PUBLIC_BUSINESS_CONTACT=

# Optional: Google sign-in, cloud backup (Firebase) and Google Calendar sync. Leave empty to keep the app local-only.
# Firebase console › Project settings › Your apps › Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Cloud › APIs & Services › Credentials: the "Web client" (auto-created by Firebase) and the iOS client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
