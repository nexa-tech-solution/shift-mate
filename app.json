{
  "expo": {
    "name": "Shiftly",
    "slug": "shiftmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shiftmate",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F0E8",
    "ios": {
      "bundleIdentifier": "com.shiftmate.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shiftmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Shiftly adds your shifts to the calendar you choose, such as your Google Calendar.",
          "remindersPermission": "Shiftly does not use your reminders."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#E0441C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#E0441C",
          "dark": {
            "backgroundColor": "#E0441C"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "ClockWidget",
              "displayName": "Shift clock",
              "description": "Your clock-in timer and next shift.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
